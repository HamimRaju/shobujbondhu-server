NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=shobujbondhu

# Use a randomly generated secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# Public server origin only; Better Auth uses /api/auth as its base path.
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Set both Google OAuth values to enable Google sign-in. Leave both blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional additional allowed frontend origins, comma-separated.
CORS_ORIGINS=
