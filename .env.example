NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=shobujbondhu

# Use a random secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Optional Google OAuth. Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional additional frontend origins, comma-separated.
CORS_ORIGINS=
